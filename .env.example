# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-this-value-in-your-local-env-file
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database: use postgresql for normal development.
# sqlite is allowed only for the initial bootstrap smoke check.
DJANGO_DATABASE_ENGINE=postgresql
POSTGRES_DB=formaflow
POSTGRES_USER=formaflow
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0

# Email: local settings use the console backend by default.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Forma Flow <noreply@example.test>

# Logging
DJANGO_LOG_LEVEL=INFO
